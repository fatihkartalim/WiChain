        "title",
        "description",
        "city",
        "address",
        "latitude",
        "longitude",
        "pricePerHour",
        "downloadSpeed",
        "uploadSpeed",
        "isOnline",
        "status",
        "createdAt",
        "updatedAt",
        "archivedAt"
      ],
      "Package": [
        "id",
        "hotspotId",
        "name",
        "durationMinutes",
        "priceUsd",
        "priceNativeToken",
        "maxDevices",
        "isActive",
