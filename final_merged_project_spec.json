        "userId",
        "hotspotOwnerId",
        "amount",
        "tokenSymbol",
        "network",
        "txHash",
        "status",
        "createdAt"
      ],
      "Rating": [
        "id",
        "userId",
        "hotspotId",
        "purchaseId",
        "score",
        "comment",
        "createdAt"
      ]
    },
