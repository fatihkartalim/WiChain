{
  "project_name": "depin-wifi-marketplace",
  "spec_version": "2.0",
  "language": "en",
  "goal": "Build a real DePIN-style neighborhood Wi-Fi marketplace where hotspot owners register internet-sharing hotspots, users discover nearby hotspots, purchase access packages through Monad Testnet blockchain payments, start sessions, track remaining time, and rate service quality. Frontend and backend must live in separate folders. Backend must follow layered architecture. Frontend must be able to start before backend completion using this contract as the source of truth.",
  "delivery_mode": {
    "frontend_can_start_before_backend": true,
    "source_of_truth": "This file defines architecture, API contracts, validation, response schemas, business rules, enums, frontend routes, blockchain flow, and mocking rules.",
    "progress_file": {
      "enabled": true,
      "file_name": "progress",
      "rules": [
        "Append entries only",
        "Never delete old entries",
        "Each entry must include date, completed work, next step, blockers, assumptions",
        "Preferred format: Date | Done | Next | Issues | Notes"
      ]
    }
  },
  "root_structure": [
    "frontend/",
    "backend/",
    "README.md",
    "progress"
  ],
  "backend": {
    "stack": [
      "Node.js",
      "TypeScript",
      "Express.js",
      "PostgreSQL",
      "Prisma ORM",
      "JWT Authentication",
      "Ethers.js",
      "Redis (optional for session timers/cache)"
    ],
    "architecture": "layered architecture",
    "base_url": "/api/v1",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer <token>"
    },
    "layers": {
      "presentation": [
        "routes",
        "controllers",
        "request validation",
        "DTO mapping",
        "middlewares"
      ],
      "application": [
        "services",
        "use cases",
        "business orchestration"
      ],
      "domain": [
        "entities",
        "interfaces",
        "business rules",
        "value objects"
      ],
      "infrastructure": [
        "database",
        "repositories",
        "blockchain integrations",
        "config",
        "logging"
      ]
    },
    "structure": [
      "backend/src/presentation",
      "backend/src/application",
      "backend/src/domain",
      "backend/src/infrastructure",
      "backend/src/shared",
      "backend/tests"
    ],
    "roles": [
      "USER",
      "NODE_OWNER",
      "ADMIN"
    ],
    "response_format": {
      "success": {
        "success": true,
        "message": "optional",
        "data": {}
      },
      "error": {
        "success": false,
        "message": "Readable error",
        "code": "VALIDATION_ERROR",
        "errors": [
          {
            "field": "email",
            "message": "Invalid email"
          }
        ]
      }
    },
    "status_codes": {
      "200": "OK",
      "201": "Created",
      "204": "No Content",
      "400": "Bad Request",
      "401": "Unauthorized",
      "403": "Forbidden",
      "404": "Not Found",
      "409": "Conflict",
      "422": "Validation Error",
      "500": "Internal Server Error"
    },
    "enums": {
      "userRole": [
        "USER",
        "NODE_OWNER",
        "ADMIN"
      ],
      "hotspotStatus": [
        "DRAFT",
        "ACTIVE",
        "OFFLINE",
        "SUSPENDED",
        "ARCHIVED"
      ],
      "paymentStatus": [
        "PENDING",
        "CONFIRMED",
        "FAILED",
        "EXPIRED"
      ],
      "sessionStatus": [
        "PENDING",
        "ACTIVE",
        "ENDED",
        "EXPIRED"
      ],
      "transactionStatus": [
        "PENDING",
        "CONFIRMED",
        "FAILED"
      ],
      "sortOptions": [
        "price",
        "distance",
        "rating",
        "speed",
        "newest"
      ]
    },
    "entities": {
      "User": [
        "id",
        "name",
        "email",
        "passwordHash",
        "walletAddress",
        "role",
        "createdAt",
        "updatedAt"
      ],
      "Hotspot": [
